{
  "name": "@webmcp-kit/react",
  "version": "0.1.0",
  "description": "React hooks and provider for WebMCP tool registration",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "use-webmcp-tool": ">=0.3.0"
  },
  "dependencies": {
    "@mcp-b/webmcp-polyfill": "^6.0.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "use-webmcp-tool": "^0.3.0",
    "vitest": "^3.0.0",
    "webmcp-types": "^0.1.10"
  }
}
