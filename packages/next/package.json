{
  "name": "@react-webmcp-kit/next",
  "version": "0.1.0",
  "description": "Next.js Server Action and high-capacity client table filter adapters for WebMCP agents",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stubbies/webmcp-kit-react.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/stubbies/webmcp-kit-react/tree/main/packages/next#readme",
  "bugs": {
    "url": "https://github.com/stubbies/webmcp-kit-react/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@react-webmcp-kit/core": "^0.1.0",
    "react": ">=18",
    "zod": ">=3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "@react-webmcp-kit/core": "workspace:*",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "use-webmcp-tool": "^0.3.0",
    "vitest": "^3.0.0",
    "zod": "^3.24.1"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "react",
    "nextjs",
    "server-actions",
    "data-table",
    "ai-agents"
  ]
}
